---
import Archive from '../../layouts/Archive.astro';
import {buildLexicon,conceptUrl} from '../../lib/lexicon';
import ChapterList from '../../components/ChapterList.astro';
import DocumentCard from '../../components/DocumentCard.astro';
import {documents,topics,docTopics,topicUrl,type Doc} from '../../lib/discovery';
export async function getStaticPaths(){return topics(await documents()).map(t=>({params:{id:t.id},props:{topic:t}}));}
const {topic:t}=Astro.props;
const ds=await documents();
const matching=ds.filter(d=>docTopics(d).some(x=>x.id===t.id));
const chapters=matching.flatMap(d=>d.data.chapterIndex.filter(c=>c.topics.some(x=>x.id===t.id)).map(c=>({d,c})));
const lexicon=buildLexicon(matching);const matchingWords=lexicon.terms.filter(w=>w.occurrences.some(o=>o.topics.includes(t.id)));const matchingConcepts=lexicon.concepts.filter(c=>c.occurrences.some(o=>o.topics.includes(t.id)));
const adjacent=[...new Map(chapters.flatMap(({c})=>c.topics).filter(x=>x.id!==t.id).map(x=>[x.id,x])).values()];
---
<Archive title={t.name+' — The Annotated World'} wide><header class="browse-header"><p class="eyebrow"><a href="/topics/">テーマ</a> / TOPIC</p><h1>#{t.name}</h1><p>{matching.length}資料 · {chapters.length}関連章</p></header>
 {chapters.length>0&&<section class="browse-section"><div class="section-heading"><h2>Chapters <small>このテーマが登場する章</small></h2></div><ChapterList items={chapters}/></section>}
 <section class="browse-section"><div class="section-heading"><h2>Documents <small>関連する資料全文</small></h2></div><div class="document-grid">{matching.map(d=><DocumentCard doc={d}/>)}</div></section>
 {adjacent.length>0&&<section class="browse-section"><div class="section-heading"><h2>Related topics <small>同じ章で扱われているテーマ</small></h2></div><div class="tag-row">{adjacent.map(x=><a class="topic-tag" href={topicUrl(x.id)}>#{x.name}</a>)}</div></section>}
{matchingWords.length>0&&<section class="browse-section"><div class="section-heading"><h2>Words <small>このテーマの章に登場する語彙</small></h2><a href="/words/">語彙一覧 →</a></div><div class="tag-row">{matchingWords.slice(0,24).map(w=><a class="topic-tag" href={'/words/'+w.id+'/'}>{w.label}</a>)}</div></section>}
{matchingConcepts.length>0&&<section class="browse-section"><div class="section-heading"><h2>References <small>関連する知識索引</small></h2></div><div class="tag-row">{matchingConcepts.map(c=><a class="topic-tag" href={conceptUrl(c.id)}>{c.ja}</a>)}</div></section>}</Archive>