---
import Archive from '../../layouts/Archive.astro';
import motion from '../../data/editorial-motion.json';
import edition from '../../data/archive-edition.json';
import notes from '../../data/marginalia.json';
import {documents,chapterReadingUrl} from '../../lib/discovery';
const docs=await documents();
const doc=docs.find(d=>d.id===motion.document);
const chapter=doc?.data.chapterIndex.find(c=>c.anchor===motion.chapter);
const note=notes.find(n=>n.id===motion.noteId);
if(!doc||!chapter||!note)throw new Error('Motion must link a real editorial note and source chapter');
const href=chapterReadingUrl(doc,chapter);
---
<Archive wide title="閉館後の編集記録003 — モーション試作" description="架空の注釈者の短い映像と、元教材への入口。">
 <div class="aw-motion-layout">
  <div class="aw-motion-copy"><p class="aw-section-kicker">MOTION STUDY / 003</p><h1>規則を変える自由。</h1><p>編集記録を9秒の縦長モーションにした試作。キャラクターの台詞は創作であり、講演者の引用ではありません。</p><div class="aw-motion-controls"><button id="aw-motion-play" type="button">再生する</button><button id="aw-motion-next" type="button">次の場面</button></div><p id="aw-motion-status" role="status">場面 1 / 3</p><a class="aw-motion-source" href={href}>関連する原文を読む →</a><p>{chapter.title}</p><a href="/marginalia/#note-rules">元の編集記録へ →</a><details><summary>映像の内容（テキスト）</summary>{motion.beats.map(b=><p>{b.lines.join(' ')}</p>)}</details></div>
  <div id="aw-motion-stage" class="aw-motion-stage" data-duration={motion.duration} style={Object.entries(edition.style).map(([k,v])=>'--motion-'+k+':'+v).join(';')} aria-hidden="true">
   <img class="aw-motion-bg" src="/brand/catalog-mobile.webp" alt="" width="768" height="432"/>
   <div class="aw-motion-grid"></div><div class="aw-motion-orbit"></div>
   <div class="aw-motion-brand"><img src="/brand/archive-seal.svg" alt="" width="60" height="60"/><span>THE ANNOTATED<br/>WORLD.</span><span>LOG<br/>003</span></div>
   {motion.beats.map((b,i)=><div class="aw-motion-shot" data-motion-shot={i} data-start={b.start} data-end={b.end} hidden={i!==0}><small>{b.kicker}</small><div class="aw-motion-lines">{b.lines.map(line=><strong>{line}</strong>)}</div><div class="aw-motion-art"><img src={'/brand/sprites/'+b.sprite+'.webp'} alt=""/></div></div>)}
   <div class="aw-motion-footer"><span>{motion.credit}</span><strong>THE ANNOTATED WORLD / READ THE SOURCE</strong><div class="aw-motion-progress"><i></i></div></div>
  </div>
 </div>
 <script>
 const stage=document.getElementById('aw-motion-stage')!;
 const play=document.getElementById('aw-motion-play') as HTMLButtonElement;
 const next=document.getElementById('aw-motion-next') as HTMLButtonElement;
 const status=document.getElementById('aw-motion-status')!;
 const shots=[...stage.querySelectorAll<HTMLElement>('[data-motion-shot]')];
 const duration=Number(stage.dataset.duration);
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 let frame=0,running=false,position=0,origin=0;
 function seek(t:number){
  position=Math.max(0,Math.min(duration-.001,t));
  const i=Math.max(0,shots.findIndex(s=>position>=Number(s.dataset.start)&&position<Number(s.dataset.end)));
  const shot=shots[i]; const p=(position-Number(shot.dataset.start))/(Number(shot.dataset.end)-Number(shot.dataset.start));
  for(const [j,s] of shots.entries())s.hidden=i!==j;
  stage.style.setProperty('--motion-progress',String(position/duration));
  stage.style.setProperty('--shot-progress',String(reduced.matches?1:p));
  stage.style.setProperty('--shot-rise',String(reduced.matches?0:Math.max(0,1-p*5)));
  stage.dataset.activeShot=String(i);
  const label='場面 '+(i+1)+' / '+shots.length;if(status.textContent!==label)status.textContent=label;
 }
 function stop(){cancelAnimationFrame(frame);running=false;play.textContent='再生する';}
 function tick(now:number){const t=(now-origin)/1000;if(t>=duration){seek(duration);stop();return;}seek(t);frame=requestAnimationFrame(tick);}
 play.addEventListener('click',()=>{if(running){stop();return;}if(reduced.matches){seek(0);status.textContent='動きを減らす設定が有効です。「次の場面」でご覧ください。';return;}origin=performance.now();running=true;play.textContent='停止する';frame=requestAnimationFrame(tick);});
 next.addEventListener('click',()=>{stop();const i=(Number(stage.dataset.activeShot)+1)%shots.length;seek(Number(shots[i].dataset.start)+.6);});
 stage.addEventListener('aw-motion-seek',e=>{stop();seek(Number((e as CustomEvent).detail));});
 document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
 reduced.addEventListener('change',()=>{stop();seek(position);});
 seek(0);
 </script>
</Archive>
