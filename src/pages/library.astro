---
import Archive from '../layouts/Archive.astro';
import DocumentCard from '../components/DocumentCard.astro';
import GenreNav from '../components/GenreNav.astro';
import {documents,genres} from '../lib/discovery';
const ds=await documents();
---
<Archive title="全資料 — The Annotated World" wide>
 <header class="browse-header"><p class="eyebrow">LIBRARY</p><h1>すべての資料</h1><p>タイトル、話者、テーマ、章の内容から探す。</p></header>
 <div class="library-toolbar"><label for="find">検索<input type="search" id="find" placeholder="例：ジジェク、映画、AI"/></label><span id="result-count" aria-live="polite">{ds.length}資料</span></div>
 <GenreNav docs={ds}/>
 <section class="browse-section"><div class="document-grid" id="result-grid">{ds.map(d=><DocumentCard doc={d}/>)}</div><p id="no-documents" hidden>該当する資料がありません。別のキーワードをお試しください。</p></section>
</Archive>
<script>
const input=document.querySelector<HTMLInputElement>('#find')!;
const params=new URLSearchParams(location.search);input.value=params.get('q')||'';
const cards=[...document.querySelectorAll<HTMLElement>('[data-document]')];
function filter(){const q=input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);let n=0;for(const card of cards){card.hidden=!q.every(t=>card.dataset.search?.includes(t));if(!card.hidden)n++;}document.getElementById('result-count')!.textContent=n+'資料';document.getElementById('no-documents')!.hidden=n!==0;}
input.addEventListener('input',filter);filter();
</script>