---
import RoomHeader from '../../components/RoomHeader.astro';
import Archive from '../../layouts/Archive.astro';
import OccurrenceList from '../../components/OccurrenceList.astro';
import {documents,topics,topicUrl} from '../../lib/discovery';
import {buildLexicon,conceptUrl,containsPhrase,documentCount,occurrenceUrl} from '../../lib/lexicon';
export async function getStaticPaths(){const ds=await documents(),{concepts,terms}=buildLexicon(ds),ts=topics(ds);return concepts.map(c=>({params:{id:c.id},props:{concept:c,words:terms.filter(t=>c.aliases.some(a=>containsPhrase(t.label,a))),related:concepts.filter(x=>x.id!==c.id&&x.occurrences.some(o=>c.occurrences.some(y=>y.documentId===o.documentId&&y.anchor===o.anchor))),topics:ts.filter(t=>c.topics.includes(t.id)||c.occurrences.some(o=>o.topics.includes(t.id)))}}));}
const {concept:c,words,related,topics:ts}=Astro.props;
const annotated=c.occurrences.filter(o=>o.note.trim()).slice(0,3);
---
<Archive title={c.name+' — 知識索引'} wide><RoomHeader room="concepts" compact><p class="eyebrow"><a href="/concepts/">知識索引</a> / {c.kind}</p><h1>{c.name}</h1><p>{c.ja} · {documentCount(c.occurrences)}資料 · {c.occurrences.length}発話</p><p>本文中の登録語に基づく索引。人物・作品の詳細や発言内容の真偽を検証した事典ではありません。</p></RoomHeader>
{c.id==='surplus-enjoyment'&&<section class="aw-editorial-sheet"><p class="aw-section-kicker">READING QUESTION / 読解の補助線</p><h2>なぜ満足しても、また欲しくなるのか。</h2><p>余剰享楽（剰余享楽）は、単に欲しいものを手に入れて終わる満足とは異なる、欲望と反復をめぐる精神分析の概念です。このページでは、教材中で実際に使われた箇所から、ジジェクがどのような文脈でこの語を使っているかを読みます。</p><p><strong>考えるための例（編集部による創作）：</strong> のどの渇きが収まった後も、コーラを飲む行為を続けたくなる。この例は概念への入口であり、原典からの引用でも厳密な定義の代替でもありません。</p><a href="#concept-occurrences">教材中の使用例へ ↓</a>{c.occurrences[0]&&<p><a href={occurrenceUrl(c.occurrences[0])}>原文の該当発話を読む →</a></p>}</section>}
{annotated.length>0&&<section class="aw-editorial-sheet"><p class="aw-section-kicker">SOURCE NOTES / 出典のある注釈</p><h2>元教材の解説を手がかりに</h2><p>概念が登場する発話に付いた既存注釈です。他の語句や背景説明も含むため、概念自体の定義とは区別します。</p><ul class="aw-source-list">{annotated.map(o=><li><details><summary>{o.chapterTitle} · {o.time}</summary><p>{o.note}</p><a href={occurrenceUrl(o)}>元の発話と注釈を読む →</a></details><small>{o.documentTitle}</small></li>)}</ul></section>}
<section id="concept-occurrences" class="browse-section"><div class="section-heading"><h2>In context <small>教材で登場する箇所</small></h2></div><OccurrenceList items={c.occurrences} needle={c.name} aliases={c.aliases}/></section>
{words.length>0&&<section class="browse-section"><div class="section-heading"><h2>Words <small>語彙・表現</small></h2></div><div class="tag-row">{words.map(t=><a class="topic-tag" href={'/words/'+t.id+'/'}>{t.label}</a>)}</div></section>}
{related.length>0&&<section class="browse-section"><div class="section-heading"><h2>Connections <small>同じ発話に登場する項目</small></h2></div><div class="tag-row">{related.map(x=><a class="topic-tag" href={conceptUrl(x.id)}>{x.ja}</a>)}</div></section>}
{ts.length>0&&<section class="browse-section"><div class="section-heading"><h2>Topics <small>関連テーマ</small></h2></div><div class="tag-row">{ts.map(t=><a class="topic-tag" href={topicUrl(t.id)}>#{t.name}</a>)}</div></section>}
</Archive>