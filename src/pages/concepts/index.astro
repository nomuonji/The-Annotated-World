---
import IndexCard from '../../components/IndexCard.astro';
import IndexSearch from '../../components/IndexSearch.astro';
import EditorialTitle from '../../components/EditorialTitle.astro';
import Archive from '../../layouts/Archive.astro';
import {documents} from '../../lib/discovery';
import {buildLexicon,conceptUrl,documentCount} from '../../lib/lexicon';
const {concepts}=buildLexicon(await documents());
---
<Archive title="知識索引 — The Annotated World" wide><EditorialTitle section="concepts" label="知識索引" count={concepts.length+'項目'} art="marginalia-cards"><h1 lang="en">Ideas &amp; references<span class="ed-period">.</span></h1><p>概念、人物、作品から原文の文脈へ。</p></EditorialTitle><IndexSearch label="概念・人物・作品を検索" count={concepts.length} unit="項目" placeholder="例：ラカン、enjoyment"/>
{['概念','人物','書籍','映画','ドラマ'].map(kind=>{const list=concepts.filter(c=>c.kind===kind);return list.length>0&&<section class="browse-section" data-index-section><div class="section-heading"><h2>{kind}</h2></div><div class="word-grid aw-concept-drawer">{list.map((c,i)=><IndexCard kind={kind} serial={i+1} href={conceptUrl(c.id)} title={c.name} detail={c.ja} meta={documentCount(c.occurrences)+"資料 · "+c.occurrences.length+"発話"} search={[c.name,c.ja,c.kind,...c.aliases].join(" ")}/>)}</div></section>;})}
</Archive>