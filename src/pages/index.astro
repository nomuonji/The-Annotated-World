---
import SceneArchive from '../layouts/SceneArchive.astro';
import art from '../data/scene-first-art.json';
import edition from '../data/archive-edition.json';
import {documents,displayDocumentTitle,documentUrl,docTopics,topicUrl,searchText,genres,genreUrl,genreDocs,genreChapters,chapterReadingUrl} from '../lib/discovery';
const ds=await documents();
const chapters=ds.flatMap(d=>d.data.chapterIndex.map(c=>({d,c})));
const picks=chapters.filter(({c})=>c.topics.length>0).sort((a,b)=>b.c.topics.length-a.c.topics.length||a.c.order-b.c.order).slice(0,6);
const paths=chapters.map(({d,c})=>chapterReadingUrl(d,c));
const freeDoc=ds.find(d=>d.id==='slavoj-zizek-how-to-become-free');
---
<SceneArchive>
<header class="masthead" slot="masthead"><a href="/" class="brand"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 0v24M0 12h24M4 4l16 16M20 4L4 20M12 4l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/></svg><span><strong>The Annotated World</strong><small>思想と語る、注釈の資料室</small></span></a><nav aria-label="資料室の入口"><a href="/library/"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5q5-3 8 1v14q-4-4-8-1zM20 5q-5-3-8 1v14q4-4 8-1zM7 8l3 1m-3 3 3 1m4-4 3-1m-3 5 3-1"/></svg><span>教材</span></a><a href="/topics/"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13l13-9 4 5-13 9zM14 12l5 10m-8-8-5 8M16 4l2-2 4 5-2 2"/></svg><span>テーマ</span></a><a href="/words/"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6m-5 0v7l-6 9q-1 2 2 2h12q3 0 2-2l-6-9V3M7 16h10M10 18h.1m4-3h.1"/></svg><span>語彙</span></a><a href="/concepts/"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 0v24M0 12h24M4 4l16 16M20 4L4 20M12 4l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/></svg><span>概念</span></a><a href="/people/"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M5 21v-3q0-5 7-5t7 5v3zM3 21h18"/></svg><span>人物</span></a><a href="/workspace/"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="5"/><path d="M12 12l9 9m-4-4 3-3m-6 0 2-2"/></svg><span>私室</span></a></nav><form class="search" id="search-form" role="search" action="/library/" method="get"><input type="search" id="query" name="q" placeholder="教材・話者・テーマを検索…" aria-label="教材・話者・テーマを検索"><button aria-label="検索"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></button></form><button class="scene-theme" id="site-theme-toggle" type="button" aria-pressed="false" aria-label="サイト全体の配色を切り替える">ダーク</button></header><section class="stage" aria-label="夜の資料室"><div class="opening"><div class="hero-copy"><svg class="orbit" viewBox="0 0 300 170" fill="none" aria-hidden="true"><ellipse cx="150" cy="84" rx="132" ry="65" transform="rotate(-15 150 84)" stroke="currentColor" stroke-width=".65"/><ellipse cx="150" cy="84" rx="143" ry="45" transform="rotate(20 150 84)" stroke="currentColor" stroke-width=".65"/><path d="M44 35l4 8-4 8-4-8zM248 113l4 8-4 8-4-8zM174 10l3 6-3 6-3-6z" fill="#f9d89f"/></svg><p class="eyebrow">THE MIDNIGHT ARCHIVE</p><h1 lang="en"><span>The</span>Annotated<em>World.</em></h1><p class="tagline">世界には注釈を。<br/>自分には、まだ。</p><p class="desc">哲学・文学・映画・社会・技術——世界の言葉を、英語の原文と対訳、注釈でたどる。世界の読み方を疑うための資料室。</p><div class="aw-world-actions"><a class="hero-action aw-world-enter" href="/library/"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5q5-3 8 1v14q-4-4-8-1zM20 5q-5-3-8 1v14q4-4 8-1zM7 8l3 1m-3 3 3 1m4-4 3-1m-3 5 3-1"/></svg> 教材を探す <span aria-hidden="true">→</span></a>{paths.length>0&&<button type="button" class="scene-random" data-random={JSON.stringify(paths)} hidden>ランダムな章へ ↗</button>}</div></div></div><section class="atlas aw-atlas-section" id="archive-index" data-edition={edition.season} aria-labelledby="atlas-title"><h2 class="atlas-head" id="atlas-title">資料室の案内図<small>— Library Map —</small></h2><nav class="aw-atlas-nav" aria-label="資料室の各部屋"><div class="atlas-grid"><svg class="atlas-wires" viewBox="0 0 600 320" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M100 74H500M100 246H500M100 74Q100 160 300 160T500 246M500 74Q500 160 300 160T100 246M300 74V246" stroke="currentColor" stroke-width="1.2"/><g fill="#ffe1a6"><circle cx="200" cy="74" r="3"/><circle cx="400" cy="74" r="3"/><circle cx="200" cy="246" r="3"/><circle cx="400" cy="246" r="3"/></g></svg><a class="portal" href="/library/" data-room-link="library"><span class="portal-window aw-atlas-portal"><img src={art.rooms[0]} alt=""></span><span class="portal-caption"><strong>書庫</strong><small>教材・資料の一覧</small></span><span class="portal-jewel" aria-hidden="true">✧</span></a><a class="portal" href="/topics/" data-room-link="observatory"><span class="portal-window aw-atlas-portal"><img src={art.rooms[1]} alt=""></span><span class="portal-caption"><strong>観測室</strong><small>テーマ・思想</small></span><span class="portal-jewel" aria-hidden="true">✧</span></a><a class="portal" href="/words/" data-room-link="lexicon"><span class="portal-window aw-atlas-portal"><img src={art.rooms[2]} alt=""></span><span class="portal-caption"><strong>標本室</strong><small>語彙・表現</small></span><span class="portal-jewel" aria-hidden="true">✧</span></a><a class="portal aw-atlas-cinema" href="#video-shelf"><span class="portal-window aw-atlas-portal"><img src={art.rooms[3]} alt=""></span><span class="portal-caption"><strong>映写室</strong><small>動画教材</small></span><span class="portal-jewel" aria-hidden="true">✧</span></a><a class="portal" href="/people/" data-room-link="people"><span class="portal-window aw-atlas-portal"><img src={art.rooms[4]} alt=""></span><span class="portal-caption"><strong>人物資料室</strong><small>話者・著者</small></span><span class="portal-jewel" aria-hidden="true">✧</span></a><a class="portal" href="/workspace/" data-room-link="private"><span class="portal-window aw-atlas-portal"><img src={art.rooms[5]} alt=""></span><span class="portal-caption"><strong>私室</strong><small>個人教材・ノート</small></span><span class="portal-jewel" aria-hidden="true">✧</span></a><span class="atlas-centre"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 0v24M0 12h24M4 4l16 16M20 4L4 20M12 4l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/></svg></span></div><div class="atlas-extra"><a href="/concepts/" data-room-link="concepts">✧ 概念の索引 ↗</a></div></nav></section></section><div class="main-shelf"><section class="panel featured" id="video-shelf"><i class="corners"></i><h2 class="section-title"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="10" r="8"/><circle cx="12" cy="10" r="1"/><circle cx="12" cy="5.5" r="1.6"/><circle cx="16" cy="12" r="1.6"/><circle cx="8" cy="12" r="1.6"/><path d="M16 17l5 4H6"/></svg> 注目の教材 <small>Featured Lessons</small></h2><div class="featured-list">{ds.slice(0,3).map(d=><article class="edition document-entry" data-document data-search={searchText(d)}>
<a class="document-cover" href={documentUrl(d)} aria-label={d.data.title}><div class="cover-fallback"><strong>{displayDocumentTitle(d.data.title)}</strong><small>{d.data.author}</small></div>{d.data.videoId&&<img class="source-thumbnail" src={'https://i.ytimg.com/vi/'+d.data.videoId+'/hqdefault.jpg'} alt="" width="480" height="360" loading="eager" decoding="async"/>}{d.data.videoId&&<span class="video-marker" aria-hidden="true">▶ {d.data.duration}</span>}</a>
<a class="edition-name" href={documentUrl(d)}><h3>{displayDocumentTitle(d.data.title)}</h3>{displayDocumentTitle(d.data.title)!==d.data.title&&<span class="scene-edition-suffix">{d.data.title.slice(displayDocumentTitle(d.data.title).length)}</span>}</a>
<span class="edition-author">{d.data.people.map(p=>p.name).join(' · ')||d.data.author}</span><span class="edition-chapters">{d.data.chapterCount}章 · 対訳全文</span>
<div class="scene-tags">{docTopics(d).slice(0,3).map(t=><a href={topicUrl(t.id)}>#{t.name}</a>)}</div></article>)}</div><p class="scene-archive-count">{ds.length}資料 · {chapters.length}章 <a href="/library/">全資料へ ↗</a></p></section><section class="panel theme-panel"><i class="corners"></i><h2 class="section-title"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 0v24M0 12h24M4 4l16 16M20 4L4 20M12 4l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/></svg> テーマから読む</h2><div class="theme-art"></div><h3>自由とは何か</h3><p>自由・選択・責任。思想の原典から問いを深める。</p><a class="plaque" href={freeDoc?documentUrl(freeDoc):"/topics/"}>関連教材を読む <span aria-hidden="true">→</span></a></section><section class="panel index-panel"><i class="corners"></i><h2 class="section-title"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v19m-6 0h12M3 6h18M5 6l-4 9h8L5 6zm14 0-4 9h8l-4-9z"/></svg> 探究の入口</h2><div class="index-links"><a href="/topics/"><img src={art.indexes[0]} alt=""><span><strong>思想のテーマ</strong><small>テーマから原典へ</small></span></a><a href="/concepts/"><img src={art.indexes[1]} alt=""><span><strong>知識索引</strong><small>概念のつながりを読む</small></span></a><a href="/words/"><img src={art.indexes[2]} alt=""><span><strong>語彙標本</strong><small>原文から言葉を学ぶ</small></span></a></div></section></div><div class="lower"><section class="panel"><i class="corners"></i><h2 class="section-title"><svg class="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 22Q7 5 21 2q-1 13-15 15zM3 22L18 5M8 15l-1-5m5 1 4 1"/></svg> 主要な探究領域 <small>Explore by Domain</small></h2><div class="domains">{genres.map(g=><a class="genre-tile" href={genreUrl(g.id)}><span class="medal"><img src={'/brand/genres/'+g.id+'-emblem.svg'} alt="" width="60" height="48" loading="eager"/></span><span>{g.ja}</span><small>{genreDocs(ds,g.id).length}資料 · {genreChapters(ds,g.id).length}章</small></a>)}</div></section><section class="panel about"><i class="corners"></i><div class="about-art" role="img" aria-label="月夜に照らされた資料室"></div><div><h2>この資料室について</h2><small>About This Library</small><p>The Annotated World は、世界の言葉を「読む・訳す・注釈する」ことで、思考を深めるための学習・探究の場です。</p><a href="/library/">はじめての方へ <span aria-hidden="true">→</span></a></div></section></div>
{picks.length>0&&<section class="panel scene-chapters" id="reading-room" aria-labelledby="chapter-heading"><i class="corners" aria-hidden="true"></i><h2 class="section-title" id="chapter-heading">気になる話題から読む <small>Follow your curiosity</small></h2><div class="scene-chapter-grid">{picks.map(({d,c})=><a href={chapterReadingUrl(d,c)}><time>{c.time}</time><span><strong>{c.title}</strong><small>{displayDocumentTitle(d.data.title)}</small></span></a>)}</div><a class="scene-more" href="/topics/">テーマ一覧へ →</a></section>}

</SceneArchive>
<script>
for(const img of document.querySelectorAll<HTMLImageElement>('.document-cover .source-thumbnail')){const fail=()=>{img.hidden=true;};img.addEventListener('error',fail,{once:true});if(img.complete&&img.naturalWidth===0)fail();}
for(const b of document.querySelectorAll<HTMLButtonElement>('[data-random]')){const paths:string[]=JSON.parse(b.dataset.random||'[]');if(paths.length){b.hidden=false;b.addEventListener('click',()=>location.assign(paths[Math.floor(Math.random()*paths.length)]));}}
</script>
