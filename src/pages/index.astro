---
import Archive from '../layouts/Archive.astro';
import {getCollection} from 'astro:content';
const documents=(await getCollection('documents')).sort((a,b)=>b.data.date.localeCompare(a.data.date)||a.id.localeCompare(b.id));
---
<Archive>
<header class="archive-head">
 <p class="hero-meta">原文・対訳・注釈</p>
 <h1>The Annotated World</h1>
 <p class="deck">講演、対談、読み物を、英文と日本語訳、言葉と背景の注釈を添えて読むためのアーカイブ。</p>
</header>
<section aria-labelledby="archive-heading" class="archive-list">
 <div class="archive-list-head"><h2 id="archive-heading">Documents <span>全{documents.length}件</span></h2>{documents.length>1&&<label for="find">資料を検索 <input type="search" id="find" placeholder="タイトル・話者"/></label>}</div>
 {documents.map(({id,data:d})=><article class="document-entry" data-document data-search={[d.title,d.author,d.description,d.category].join(' ').toLowerCase()}>
  <p class="hero-meta">{d.meta||d.category}</p>
  <h3><a href={'/read/'+id+'/'}>{d.title}</a></h3>
  <p class="document-author">{d.author}</p>
  <p class="document-deck">{d.description}</p>
  <p class="document-facts">{d.duration||d.chapterCount+'章'} · {d.utteranceCount}発話ブロック</p>
  <a class="read-link" href={'/read/'+id+'/'}>対訳全文を読む →</a>
 </article>)}
 <p id="no-documents" hidden>該当する資料がありません。</p>
</section>
</Archive>
<script>
const search=document.querySelector<HTMLInputElement>('#find');
if(search)search.addEventListener('input',()=>{let count=0;for(const item of document.querySelectorAll<HTMLElement>('[data-document]')){item.hidden=!item.dataset.search?.includes(search.value.trim().toLowerCase());if(!item.hidden)count++;}document.getElementById('no-documents')!.hidden=count!==0;});
</script>