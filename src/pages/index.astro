---
import ArchiveAtlas from '../components/ArchiveAtlas.astro';
import Archive from '../layouts/Archive.astro';
import RandomChapter from '../components/RandomChapter.astro';
import DocumentCard from '../components/DocumentCard.astro';
import GenreNav from '../components/GenreNav.astro';
import ChapterList from '../components/ChapterList.astro';
import {documents} from '../lib/discovery';
const ds=await documents();
const featured=ds[0];
const chapters=ds.flatMap(d=>d.data.chapterIndex.map(c=>({d,c})));
const picks=chapters.filter(({c})=>c.topics.length>0).sort((a,b)=>b.c.topics.length-a.c.topics.length||a.c.order-b.c.order).slice(0,6);
---
<Archive wide>
 <div class="aw-notebook">
<header class="aw-world-opening" aria-labelledby="aw-home-title">
 <picture class="aw-world-backdrop"><source media="(max-width: 640px)" srcset="/brand/midnight-mobile.webp"/><img src="/brand/midnight-desktop.webp" width="1536" height="864" fetchpriority="high" alt="月明かりの書斎でコーラを飲みながら本を読む注釈者"/></picture>
 <div class="aw-world-copy"><p class="aw-world-serial"><span>01</span> / THE MIDNIGHT ARCHIVE</p><h1 id="aw-home-title" lang="en">The Annotated<br/><em>World.</em></h1><p class="aw-world-jp">世界には注釈を。<br/><span>自分には、まだ。</span></p><p class="aw-world-desc">英語・思想・文化の原文を、対訳と注釈で読む。<br/>ここは、世界の読み方を疑うための資料室。</p><div class="aw-world-actions"><a href="/library/" class="aw-world-enter">教材を探す <span aria-hidden="true">↗</span></a><a class="aw-world-explore-link" href="#archive-index">世界を探索する ↓</a><RandomChapter docs={ds}/></div></div>
 <div class="aw-world-opening-foot"><span>READ / ANNOTATE / DOUBT</span><a href="#video-shelf">01 — 02 <span aria-hidden="true">↓</span></a></div>
</header>
<section class="aw-home-video-shelf" id="video-shelf" aria-labelledby="video-shelf-heading"><div class="ed-screening-mast"><h2 id="video-shelf-heading" lang="en">Watch.<br/><em>Read.</em></h2><div><p>動画から読む。</p><small>{ds.length}資料 · {chapters.length}章</small></div></div>
 {featured&&<section aria-labelledby="feature-heading" class="browse-section featured-section ed-screening-feature"><div class="section-heading"><h2 id="feature-heading">注目の資料</h2><a href="/library/">全{ds.length}資料 →</a></div><DocumentCard doc={featured} featured presentation="video"/></section>}
 {ds.length>1&&<section class="browse-section"><div class="section-heading"><h2>新着資料</h2><a href="/library/">もっと見る →</a></div><div class="document-grid">{ds.slice(1,13).map(d=><DocumentCard doc={d} presentation="video"/>)}</div></section>}
</section>
<ArchiveAtlas/>
<div class="aw-reading-room" id="reading-room"><div class="aw-chapter-head"><div><small>04 / READING ROOM</small><h2>The reading room</h2></div><p>本日の読書室 · {ds.length}資料 / {chapters.length}章</p></div>


 <section aria-labelledby="genre-heading" class="browse-section"><div class="section-heading"><h2 id="genre-heading">Browse by genre <small>ジャンルから探す</small></h2></div><GenreNav docs={ds}/></section>
 {picks.length>0&&<section aria-labelledby="chapter-heading" class="browse-section"><div class="section-heading"><h2 id="chapter-heading">Follow your curiosity <small>気になる話題から読む</small></h2><a href="/topics/">テーマ一覧 →</a></div><p class="section-description">長い講演も、関心のある章から読み始められます。</p><ChapterList items={picks}/></section>}
 <p class="aw-reading-room-exit"><a href="#archive-index">資料室の案内図へ戻る ↑</a><a href="/library/">すべての教材へ →</a></p></div></div></Archive>