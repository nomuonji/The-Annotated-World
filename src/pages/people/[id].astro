---
import RoomHeader from '../../components/RoomHeader.astro';
import Archive from '../../layouts/Archive.astro';
import DocumentCard from '../../components/DocumentCard.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import {documents,people,topics} from '../../lib/discovery';
export async function getStaticPaths(){return people(await documents()).map(p=>({params:{id:p.id},props:{person:p}}));}
const {person:p}=Astro.props;
const ds=(await documents()).filter(d=>d.data.people.some(x=>x.id===p.id));
---
<Archive title={p.name+' — The Annotated World'} wide><RoomHeader room="people" compact person><span class="person-monogram" aria-hidden="true">{p.name.split(' ').map(s=>s[0]).slice(0,2).join('')}</span><div><p class="eyebrow"><a href="/people/">人物</a> / PERSON</p><h1>{p.name}</h1><p>{p.ja} · {ds.length}資料</p></div></RoomHeader><section class="aw-editorial-sheet"><p class="aw-section-kicker">PERSONAL ARCHIVE / 収録資料</p><h2>この人物を、収録資料から読む。</h2><p>人物名は資料の登録情報に基づきます。経歴や思想の全体を網羅する人物事典ではありません。各資料の原典と発言を確認してください。</p><ul class="aw-source-list">{ds.map(d=><li><a href={'/read/'+d.id+'/'}>{d.data.title}</a><p>{d.data.description}</p></li>)}</ul></section>
<section class="browse-section"><div class="section-heading"><h2>Documents <small>この人物の講演・対談・文章</small></h2></div><div class="document-grid">{ds.map(d=><DocumentCard doc={d}/>)}</div></section><section class="browse-section"><div class="section-heading"><h2>Topics <small>この人物が語るテーマ</small></h2></div><TopicLinks items={topics(ds)}/></section></Archive>