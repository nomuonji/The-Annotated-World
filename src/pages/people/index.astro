---
import RoomHeader from '../../components/RoomHeader.astro';
import Archive from '../../layouts/Archive.astro';
import IndexSearch from '../../components/IndexSearch.astro';
import {personUrl} from '../../lib/discovery';
import {documents,people} from '../../lib/discovery';
const ps=people(await documents());
---
<Archive wide title="人物 — The Annotated World"><RoomHeader room="people"><p class="eyebrow"><a href="/">発見</a> / PEOPLE</p><h1>People</h1><p>話者・著者から資料をたどる。{ps.length}人。</p></RoomHeader><IndexSearch label="人物を検索" count={ps.length} unit="人" placeholder="例：ジジェク、Žižek"/><section class="browse-section" data-index-section><div class="section-heading"><h2>話者・著者 <small>原典につながる人物資料</small></h2></div><div class="people-grid">{ps.map(p=><a class="person-item" href={personUrl(p.id)} data-index-search={p.name+" "+p.ja}><span class="person-monogram" aria-hidden="true">{p.name.split(" ").map(s=>s[0]).slice(0,2).join("")}</span><div><strong>{p.name}</strong><small>{p.ja} · {p.count}資料</small></div><span aria-hidden="true">↗</span></a>)}</div></section></Archive>