---
import Base from '../layouts/Base.astro';
---
<Base title="保存した発話 — The Annotated World"><p class="eyebrow">YOUR COMMONPLACE BOOK</p><h1 class="small-title">保存した発話</h1><p>公開教材のブックマーク。個人教材の保存済み発話は<a href="/workspace/">個人教材</a>から確認できます。</p><div id="public-saved"></div></Base>
<script>
import {read,write} from '../scripts/public-store';
const root=document.getElementById('public-saved')!;
function render(){const state=read();root.replaceChildren();if(!state.saved.length){root.textContent='読書中に「発話を保存」を押すと、ここで復習できます。';return;}for(const b of state.saved){const article=document.createElement('article');article.className='saved-row';const title=document.createElement('div');title.className='tag';title.textContent=b.title;const p=document.createElement('p');p.lang='en';p.textContent=b.en;const a=document.createElement('a');a.href='/read/'+b.lessonId+'/#'+b.anchor;a.textContent='本文を開く';const remove=document.createElement('button');remove.textContent='保存を解除';remove.addEventListener('click',()=>{const latest=read();latest.saved=latest.saved.filter(x=>x.lessonId!==b.lessonId||x.anchor!==b.anchor);write(latest);render();});article.append(title,p,a,document.createTextNode(' '),remove);root.append(article);}}
render();
</script>