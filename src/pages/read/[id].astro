---
import Archive from '../../layouts/Archive.astro';
import SourceVideo from '../../components/SourceVideo.astro';
import StudyToolbar from '../../components/StudyToolbar.astro';
import ReaderTools from '../../components/ReaderTools.astro';
import {matchingConcepts,conceptUrl} from '../../lib/lexicon';
import DocumentCard from '../../components/DocumentCard.astro';
import {getCollection,type CollectionEntry} from 'astro:content';
import {load} from 'cheerio';
import {displayDocumentTitle,genreById,genreUrl,personUrl,docTopics,topicUrl,related,documents,chapterSeconds} from '../../lib/discovery';
export async function getStaticPaths(){return (await getCollection('documents')).map(document=>({params:{id:document.id},props:{document}}));}
interface Props{document:CollectionEntry<'documents'>}
const doc=Astro.props.document,d=doc.data;
const g=genreById(d.genre),ts=docTopics(doc);
const allDocuments=await documents();
const recommendations=related(allDocuments,doc);
const $=load(d.bodyHtml,null,false);
const heroNode=$('.hero').first();
const heroTitle=heroNode.find('h1').first();
const fullTitle=heroTitle.text();
const visibleTitle=displayDocumentTitle(fullTitle);
if(visibleTitle!==fullTitle)heroTitle.text(visibleTitle).append($('<span>').addClass('aw-title-subtitle').text(fullTitle.slice(visibleTitle.length)));
const hero=heroNode.toString();heroNode.remove();
for(const c of d.chapterIndex){
 const head=$('section.sec').filter((_,el)=>$(el).attr('id')===c.anchor).find('.sec-header').first();
 if(!head.length)continue;
 const row=$('<div>').addClass('chapter-crosslinks');
 for(const t of c.topics)row.append($('<a>').addClass('topic-tag').attr('href',topicUrl(t.id)).text('#'+t.name));
 if(d.videoId&&c.seconds!==null)row.append($('<button>').attr({'type':'button','data-video-seek':String(c.seconds)}).addClass('chapter-play').text('▶ '+c.time+'から再生'));
 if(row.children().length)head.append(row);
}
// Keep the source nodes intact; only add controls alongside the transcript.
const seen=new Set<string>();
for(const c of d.chapterIndex){
 const chapter=$('section.sec').filter((_,el)=>$(el).attr('id')===c.anchor);
 chapter.find('.utterance').each((index,el)=>{
  const block=$(el),anchor=block.attr('id')||c.anchor+'-line-'+(index+1);
  if(seen.has(anchor))throw Error('Duplicate study anchor '+anchor);
  seen.add(anchor);
  block.attr('id',anchor);
  const stamp=block.find('.speaker-line').first().text().match(/\b\d{1,3}:\d{2}(?::\d{2})?\b/)?.[0];
  const seconds=stamp?stamp.split(':').reduce((n,v)=>n*60+Number(v),0):null;
  const bar=$('<div>').addClass('utterance-tools').attr('data-study-tools','');
  if(d.videoId&&seconds!==null){
   block.attr('data-utterance-start',String(seconds));
   bar.append($('<a>').addClass('study-time-link').attr({'href':'https://www.youtube.com/watch?v='+d.videoId+'&t='+seconds+'s','target':'_blank','rel':'noopener noreferrer','data-utterance-play':String(seconds),'aria-label':stamp+'の発話を再生'}).text('▶ '+stamp));
   bar.append($('<button>').attr({'type':'button','data-repeat':'','aria-pressed':'false','hidden':''}).text('↻ リピート'));
  }
  bar.append($('<button>').attr({'type':'button','data-reveal':'','aria-expanded':'false','hidden':''}).text('和訳・注釈を見る'));
  block.find('.speaker-line').first().after(bar);
  const en=block.find('.en').first(),ja=block.find('.ja').first(),note=block.find('.note').first();
  // A highlighted English word is not necessarily an editorial annotation.
  // Do not fabricate clickable vocabulary links without a corresponding note.
  const concepts=matchingConcepts(en.text());
  if(concepts.length){
   const related=$('<div>').addClass('reader-term-links');
   for(const concept of concepts)related.append($('<a>').addClass('concept-link').attr('href',conceptUrl(concept.id)).text(concept.ja));
   block.append(related);
  }

  // Canonical reader: exactly one visible format, permanently embedded in the English.
  // Structured annotations are rendered into a hidden compatibility .note for vocabulary indexing; only inline glosses appear.
  en.find('.inline-note-ref').remove();
  const annotations:Array<{label:string;explanation:string;id:string;kind:'language'|'context';anchor?:string}>=[];
  const records=note.find('.note-entry[data-note-id]').toArray();
  if(records.length){
   for(const entry of records){
    const raw=$(entry),label=raw.find('strong').first().text().trim(),full=raw.text().trim();
    annotations.push({label,explanation:full.slice(label.length).replace(/^\s*[：:]\s*/u,'').trim(),id:raw.attr('data-note-id')||'',kind:raw.attr('data-note-kind')==='context'?'context':'language',anchor:raw.attr('data-note-anchor')});
   }
  }else{
  const sourceItems=note.find('.inline-note-item').toArray();
  if(sourceItems.length){
   for(const [i,item] of sourceItems.entries()){
    const label=$(item).find('strong').first().text().trim();
    const raw=$(item).text().trim();
    annotations.push({label,explanation:raw.slice(label.length).replace(/^\s*[：:]\s*/u,'').trim(),id:anchor+'-note-'+(i+1),kind:'language'});
   }
  }else{
   let current:{label:string;parts:string[]}|null=null;
   for(const part of note.contents().toArray()){
    if(part.type==='tag'&&part.name==='strong'){
     current={label:$(part).text().trim(),parts:[]};
     annotations.push({label:current.label,explanation:'',id:anchor+'-note-'+(annotations.length+1),kind:'language'});
    }else if(current)current.parts.push($(part).text());
    if(current)annotations[annotations.length-1].explanation=current.parts.join('').replace(/^\s*[：:]\s*/u,'').trim();
   }
  }
  }
  if(!annotations.length&&note.length){
   const remainder=note.clone();remainder.find('.note-label').remove();
   const text=remainder.text().trim();
   if(text)annotations.push({label:'',explanation:text,id:anchor+'-note-1',kind:'context'});
  }

  // Resolve each editorial note to an exact source-text range, then render
  // all ranges in one document-order pass. Cheerio.find('*').contents() is NOT
  // a text walker: it visits top-level siblings before nested strong text and
  // was splitting Žižek's Hegel quotation at arbitrary characters.
  const sourceText=en.text(),lower=sourceText.toLocaleLowerCase();
  type InlineNote={id:string;kind:'language'|'context';text:string};
  type NoteGroup={start:number;end:number;notes:InlineNote[]};
  const ranges:NoteGroup[]=[];
  for(const item of annotations){
   if(!item.explanation)continue;
   const candidates=item.anchor?[item.anchor]:[
    item.label.replace(/（[^）]*）/gu,'').trim(),
    item.label.replace(/\s+\([^)]*\)\s*$/u,'').trim(),
    item.label.replace(/\[[^\]]+\]/gu,'').trim(),
    item.label.split(/\s+\/\s+/u)[0].trim(),
    item.label.replace(/\s+[A-Z]$/u,'').trim(),
    item.label.trim()
   ].flatMap(value=>[value,value.replace(/^steal the show$/i,'stole the show'),value.replace(/^stick out$/i,'sticking out')]);
   const phrase=candidates.find(value=>value.length>=4&&lower.includes(value.toLocaleLowerCase()));
   // A mistargeted note is more damaging than a build failure: never quietly
   // attach an unrelated historical explanation at the end of the paragraph.
   if(!phrase)throw Error('No exact English anchor for annotation '+item.id+' in '+anchor);
   const start=lower.indexOf(phrase.toLocaleLowerCase()),end=start+phrase.length;
   const meaning=item.label.match(/（([^）]+)）$/u)?.[1];
   ranges.push({start,end,notes:[{
    id:item.id,kind:item.kind,text:(meaning?meaning+'：':'')+item.explanation
   }]});
  }
  ranges.sort((x,y)=>x.start-y.start||x.end-y.end);
  const groups:NoteGroup[]=[];
  for(const item of ranges){
   const previous=groups.at(-1);
   if(previous&&item.start<previous.end){
    previous.end=Math.max(previous.end,item.end);
    previous.notes.push(...item.notes);
   }else groups.push({start:item.start,end:item.end,notes:[...item.notes]});
  }
  function makeGloss(group:NoteGroup){
   const container=$('<span>').addClass('annotation-group');
   if(group.notes.length>1)container.addClass('annotation-group-combined');
   for(const item of group.notes){
    const gloss=$('<span>').addClass('in-situ-annotation').attr({
     lang:'ja',role:'note','data-editorial-gloss':item.id,'data-note-kind':item.kind,'data-note-size':Array.from(item.text).length>36?'long':'short'
    });
    gloss.text('〔'+item.text+'〕');
    container.append(gloss);
   }
   return container;
  }
  type SourceLeaf={node:any;start:number;end:number;value:string};
  const leaves:SourceLeaf[]=[];
  let position=0;
  const visit=(node:any):void=>{
   if(!node)return;
   if(node.type==='text'){
    const value=String(node.data||''),start=position;
    position+=value.length;
    leaves.push({node,start,end:position,value});
   }else if(Array.isArray(node.children))for(const child of node.children)visit(child);
  };
  visit(en.get(0));
  if(position!==sourceText.length)throw Error('Reader source offsets diverged in '+anchor);
  for(const leaf of leaves){
   const hits=groups.filter(group=>group.start<leaf.end&&group.end>leaf.start);
   if(!hits.length)continue;
   const boundaries=new Set([0,leaf.value.length]);
   for(const group of hits){
    boundaries.add(Math.max(0,group.start-leaf.start));
    boundaries.add(Math.min(leaf.value.length,group.end-leaf.start));
   }
   const cuts=[...boundaries].sort((x,y)=>x-y);
   const fragment=$('<span>').addClass('annotation-fragment');
   for(let i=1;i<cuts.length;i++){
    const from=cuts[i-1],to=cuts[i],start=leaf.start+from,end=leaf.start+to;
    const value=leaf.value.slice(from,to);
    const active=groups.find(group=>group.start<=start&&group.end>=end);
    if(active){
     const kinds=[...new Set(active.notes.map(note=>note.kind))].sort().join(' ');
     fragment.append($('<span>').addClass('annotation-source').attr({
      'data-note-targets':active.notes.map(note=>note.id).join(' '),
      'data-highlight-kinds':kinds
     }).text(value));
    }else fragment.append($('<span>').text(value));
    for(const group of groups)if(group.end===end)fragment.append(makeGloss(group));
   }
   $(leaf.node).replaceWith(fragment);
  }
  if(annotations.length)note.addClass('annotation-converted');
 });
}
// Add in-place exits between chapters, without changing the canonical source text.
for(const c of d.chapterIndex){
 const section=$('section.sec').filter((_,el)=>$(el).attr('id')===c.anchor);
 section.find('.sec-header').first().prepend($('<p>').addClass('aw-reader-chapter-no').text('CHAPTER '+String(c.order).padStart(2,'0')+' / '+String(d.chapterIndex.length).padStart(2,'0')));
 const duration=chapterSeconds(doc,c);
 if(duration!==null)section.find('.sec-header').first().append($('<p>').addClass('chapter-duration').text('動画内の区間：約'+Math.ceil(duration/60)+'分'));
 const trail=$('<nav>').addClass('chapter-trail').attr('aria-label','章単位モード：章から章へ');
 const prev=d.chapterIndex[c.order-2],next=d.chapterIndex[c.order];
 const sequence=$('<div>').addClass('chapter-trail-group');
 sequence.append($('<span>').addClass('chapter-trail-heading').text('この資料の前後の章'));
 if(prev)sequence.append($('<a>').attr({'href':'/read/'+doc.id+'/?chapter='+encodeURIComponent(prev.anchor),'data-chapter-link':''}).append($('<small>').text('前の章'),$('<span>').text(prev.title)));
 if(next)sequence.append($('<a>').attr({'href':'/read/'+doc.id+'/?chapter='+encodeURIComponent(next.anchor),'data-chapter-link':''}).append($('<small>').text('次の章'),$('<span>').text(next.title)));
 if(sequence.find('a').length)trail.append(sequence);
 const topical=new Set(c.topics.map(t=>t.id));
 const people=new Set(d.people.map(p=>p.id));
 const across=allDocuments.filter(other=>other.id!==doc.id).flatMap(other=>other.data.chapterIndex.map(chapter=>{
  const shared=chapter.topics.filter(t=>topical.has(t.id));
  const samePerson=other.data.people.some(p=>people.has(p.id));
  const sameField=chapter.genres.some(g=>c.genres.includes(g));
  return {other,chapter,shared,samePerson,score:shared.length*10+(samePerson?2:0)+(sameField?1:0)};
 })).filter(item=>item.shared.length>0||item.samePerson)
  .sort((a,b)=>b.score-a.score||a.other.id.localeCompare(b.other.id)||a.chapter.order-b.chapter.order)
  .slice(0,3);
 if(across.length){
  const more=$('<div>').addClass('chapter-trail-group');
  more.append($('<span>').addClass('chapter-trail-heading').text('ほかの資料の関連章'));
  for(const item of across){
   const reason=item.shared.length?'共通テーマ：'+item.shared.map(t=>t.name).join('・'):'同じ人物を扱う別の章';
   more.append($('<a>').attr('href','/read/'+item.other.id+'/?chapter='+encodeURIComponent(item.chapter.anchor))
    .append($('<small>').text(item.other.data.title+' · '+reason),$('<span>').text(item.chapter.title)));
  }
  trail.append(more);
 }
 if(trail.children().length)section.append(trail);

}
// Catalogue typography: retain each canonical TOC link and its original text,
// but give the timestamp its own measure rather than forcing it into the title.
$('.toc-list li a').each((_,el)=>{
 const link=$(el),time=link.find('.toc-time').first();
 if(!time.length)return;
 const title=$('<span>').addClass('aw-toc-title');
 for(const node of link.contents().toArray()){
  if(node!==time.get(0))title.append(node);
 }
 link.append(title);
 link.addClass('aw-toc-entry');
});
const body=$.root().html()||'';
const status=d.provenance;
const labels={coverage:{full:'全文（照合済みの範囲）',excerpt:'抜粋',unverified:'収録範囲未確認'},transcript:{verified:'照合済み',unverified:'未確認','not-applicable':'音声なし'},translation:{verified:'確認済み',unverified:'未確認'},rights:{original:'オリジナル',licensed:'許諾・ライセンス確認済み','public-domain':'パブリックドメイン確認済み',unverified:'未確認'}};
---
<Archive title={d.title+' — The Annotated World'} description={d.description} reader>
 <script define:vars={{chapterIds:d.chapterIndex.map(c=>c.anchor)}}>
  // Apply the validated initial chapter before parsing the article; the
  // interactive reader takes ownership when its module initializes.
  const chapter=new URLSearchParams(location.search).get('chapter');
  if(chapter&&chapterIds.includes(chapter)){
   document.body.classList.add('chapter-reading-page');
   const style=document.createElement('style');
   style.id='aw-initial-chapter';
   const id=CSS.escape(chapter);
   style.textContent='.study-original section.sec:not(#'+id+'),.study-original .toc,.study-original .sources{display:none!important}.study-original #'+id+' .chapter-trail{display:flex;flex-wrap:wrap;gap:10px 12px;border-top:1px solid var(--hair);padding-top:18px;margin-top:26px}.study-original #'+id+'{padding-top:22px;margin-top:0;border-top:0}';
   document.head.append(style);
  }
 </script>
 <div class="reader-breadcrumbs"><a href="/">発見</a><span>/</span>{g&&<><a href={genreUrl(g.id)}>{g.name}</a><span>/</span></>}<span>対訳資料</span></div>
 <Fragment set:html={hero}/>
 <div class="reader-crosslinks"><div class="reader-person">{d.people.map(p=><a href={personUrl(p.id)}>{p.name}の資料 →</a>)}</div><div class="tag-row">{ts.map(t=><a class="topic-tag" href={topicUrl(t.id)}>#{t.name}</a>)}</div></div>
 <div class:list={["study-layout",{"has-video":!!d.videoId}]} data-study-reader>
  {d.videoId&&<aside class="study-sidebar" aria-label="動画・再生操作"><SourceVideo doc={doc}/></aside>}
  <div class="study-text"><StudyToolbar doc={doc}/><div class="chapter-mode-control" id="chapter-mode-control" hidden><button type="button" id="chapter-view-toggle" aria-pressed="false">章単位で読む</button><span class="chapter-mode-context" id="chapter-mode-context" hidden>出典：{d.title}</span><h1 id="chapter-accessible-title" class="sr-only" hidden>{d.title}</h1></div><ReaderTools/><div class="study-original"><Fragment set:html={body}/></div></div>
  <aside id="mobile-translation-dock" class="mobile-translation-dock" aria-label="今読んでいる英文の日本語訳" hidden>
   <div class="mobile-translation-dock-head"><span>日本語訳 <small>スクロールに連動</small></span><button type="button" id="mobile-translation-unpin" aria-label="日本語訳の固定を解除して本文内に戻す">固定解除</button></div>
   <div id="mobile-translation-text" class="mobile-translation-dock-body" lang="ja"></div>
  </aside>
  <button type="button" id="mobile-translation-pin" class="mobile-translation-pin" hidden>和訳を下に固定</button>
 </div>
 <div class="publication-note"><h2>資料の来歴・確認状況</h2>{status?<><dl class="provenance-grid"><div><dt>収録範囲</dt><dd>{labels.coverage[status.coverage]}</dd></div><div><dt>原文・音声照合</dt><dd>{labels.transcript[status.transcript]}</dd></div><div><dt>和訳レビュー</dt><dd>{labels.translation[status.translation]}</dd></div><div><dt>掲載権利</dt><dd>{labels.rights[status.rights]}</dd></div></dl><p>{status.basis}</p><p><a href={status.sourceUrl} target="_blank" rel="noopener noreferrer">原典を開く ↗</a></p><p>確認状況は編集時の記録であり、第三者による認証ではありません。</p></>:<p>原典・和訳・掲載権利の確認状況は記録されていません。</p>}</div>
 {recommendations.length>0&&<section class="browse-section"><div class="section-heading"><h2>Read next <small>関連する資料</small></h2></div><div class="document-grid">{recommendations.map(r=><DocumentCard doc={r.d} reason={r.reason}/>)}</div></section>}
 <section class="browse-section"><div class="section-heading"><h2>Explore further <small>テーマから次の発見へ</small></h2><a href="/topics/">全テーマ →</a></div><div class="tag-row">{ts.map(t=><a class="topic-tag" href={topicUrl(t.id)}>#{t.name}</a>)}</div></section>
 <a href="/library/" class="read-link">← 全資料へ</a>
</Archive>
<script>import "../../scripts/study-reader";import "../../scripts/reader-tools";</script>