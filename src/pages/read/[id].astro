---
import Archive from '../../layouts/Archive.astro';
import {getCollection} from 'astro:content';
import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('documents')).map(document=>({params:{id:document.id},props:{document}}));}
interface Props {document:CollectionEntry<'documents'>}
const {data:d}=Astro.props.document;
---
<Archive title={d.title+' — The Annotated World'} description={d.description}>
 <Fragment set:html={d.bodyHtml}/>
 <div class="publication-note"><p>提供された対訳資料の本文・注釈・章構成を保持しています。原典との照合および転載許諾の確認状況は未確認です。</p><a href="/">← 資料一覧へ</a></div>
</Archive>