---
import IndexCard from '../../components/IndexCard.astro';
import IndexSearch from '../../components/IndexSearch.astro';
import RoomHeader from '../../components/RoomHeader.astro';
import Archive from '../../layouts/Archive.astro';
import {documents} from '../../lib/discovery';
import {buildLexicon,documentCount} from '../../lib/lexicon';
const {terms}=buildLexicon(await documents());
---
<Archive title="語彙・表現 — The Annotated World" wide>
<RoomHeader room="lexicon"><p class="eyebrow"><a href="/">発見</a> / WORDS</p><h1>Words &amp; phrases</h1><p>教材で実際に使われた表現を、意味・文脈・元の発話からたどる。{terms.length}表現。</p></RoomHeader>
<IndexSearch prefix="word" label="語彙を検索" count={terms.length} unit="表現" placeholder="英語・日本語の注釈"/>
<div class="word-grid aw-specimen-drawer" id="word-grid">{terms.map((t,i)=><IndexCard serial={i+1} href={'/words/'+t.id+'/'} title={t.label} english detail={t.occurrences.find(o=>o.termNote)?.termNote} meta={documentCount(t.occurrences)+'資料 · '+t.occurrences.length+'発話'} search={[t.label,...t.occurrences.map(o=>o.termNote||o.note)].join(' ')}/>)}</div>
</Archive>