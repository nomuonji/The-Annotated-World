---
import {documentUrl,type Doc} from '../lib/discovery';
interface Props{doc:Doc;featured?:boolean;genreColor?:string;genreName?:string}
const {doc:d,featured=false,genreColor='#344f68',genreName='DOCUMENT'}=Astro.props;
const illustrated=['slavoj-zizek-how-to-become-free','slavoj-zizek-signs-from-the-future'].includes(d.id);
---
<a href={documentUrl(d)} class:list={['document-cover',{'aw-illustrated-cover':illustrated}]} aria-label={d.data.title} style={'--genre-color:'+genreColor}>
 <div class="cover-fallback"><span>THE ANNOTATED WORLD / {genreName}</span><strong>{d.data.title}</strong><small>{d.data.duration||d.data.chapterCount+'章'}</small></div>
 {illustrated?<img src={'/brand/covers/'+d.id+'.webp'} alt="" width="480" height="640" loading={featured?'eager':'lazy'} decoding="async" class="aw-cover-illustration"/>:d.data.videoId&&<img src={'https://i.ytimg.com/vi/'+d.data.videoId+'/hqdefault.jpg'} alt="" width="480" height="360" loading={featured?'eager':'lazy'} decoding="async" class="source-thumbnail"/>}
 {illustrated?<span class="aw-cover-stamp" aria-hidden="true">AW / READING EDITION</span>:d.data.videoId&&<span class="video-marker" aria-hidden="true">▶</span>}
</a>
<script>for(const img of document.querySelectorAll<HTMLImageElement>('.document-cover img')){const fallback=()=>img.hidden=true;img.addEventListener('error',fallback,{once:true});if(img.complete&&img.naturalWidth===0)fallback();}</script>
