---
import edition from '../data/archive-edition.json';
const rooms=[
 {id:'library',number:'02',en:'LIBRARY',ja:'資料の書庫',task:'教材・講演を探す',href:'/library/',view:'library-desktop.webp',sprite:'book-stack',w:435,h:265},
 {id:'observatory',number:'03',en:'OBSERVATORY',ja:'思想観測室',task:'テーマを横断する',href:'/topics/',view:'observatory-desktop.webp',sprite:'armillary',w:261,h:294},
 {id:'concepts',number:'05',en:'CATALOG OF IDEAS',ja:'概念の索引',task:'概念・作品を読む',href:'/concepts/',view:'concepts-vignette.webp',sprite:'marginalia-cards',w:413,h:216},
 {id:'lexicon',number:'04',en:'LEXICON LAB',ja:'言葉の標本室',task:'語彙・表現を探す',href:'/words/',view:'lexicon-banner.webp',sprite:'open-notebook',w:639,h:367},
 {id:'people',number:'06',en:'PERSONAL ARCHIVE',ja:'人物資料室',task:'話者・著者から読む',href:'/people/',view:'people-vignette.webp',sprite:'tied-cards',w:331,h:228},
 {id:'private',number:'08',en:'PRIVATE STUDY',ja:'自分の読書室',task:'個人教材を開く',href:'/workspace/',view:'private-room-vignette.webp',sprite:'desk-lamp',w:367,h:364}
];
---
<section class="aw-world-explore aw-atlas-section" data-edition={edition.season} id="archive-index" aria-labelledby="aw-explore-title">
 <div class="aw-atlas-heading"><div><p class="aw-atlas-eyebrow">03 / ATLAS OF THE ARCHIVE</p><h2 id="aw-explore-title">夜の資料室、案内図。</h2><p>資料、思想、言葉。読みたいものから、部屋を選ぶ。</p></div><img src="/brand/archive-seal.svg" alt="" width="84" height="84" loading="lazy"/></div>
 <div class="aw-atlas aw-architectural-atlas">
  <div class="aw-atlas-season-glow" aria-hidden="true"></div><div class="aw-atlas-scene" aria-hidden="true"><img src="/brand/atlas-gallery.webp" width="1440" height="960" alt="" loading="lazy" decoding="async"/></div>
  <img class="aw-atlas-architecture" src="/brand/archive-architecture.svg" width="1200" height="720" alt="" loading="lazy"/>
  <div class="aw-atlas-dust" aria-hidden="true"></div>
  <nav class="aw-atlas-nav" aria-label="資料室の各部屋">
   <div class="aw-atlas-center">
    <div class="aw-atlas-center-art" aria-hidden="true"><img class="aw-atlas-annotator" src="/brand/sprites/annotator-standing.webp" width="370" height="1019" alt="" loading="lazy"/><img class="aw-atlas-rabbit" src="/brand/sprites/rabbit-reading.webp" width="357" height="317" alt="" loading="lazy"/></div>
    <div class="aw-atlas-central-caption"><img src="/brand/archive-folio.svg" width="120" height="36" alt="" loading="lazy"/><small>01 / THE ANNOTATOR</small><strong>中央資料室</strong><span>世界には注釈を。自分には、まだ。</span></div>
    <a class="aw-atlas-cinema" href="#video-shelf"><span aria-hidden="true">▷</span><span><small>07 / SCREENING ROOM</small>映写室 · 動画から読む</span></a>
   </div>
   {rooms.map(room=><a class:list={['aw-atlas-room','aw-atlas-'+room.id]} href={room.href} data-room-link={room.id}>
    <span class="aw-atlas-portal" aria-hidden="true"><img src={'/brand/rooms/'+room.view} alt="" width="760" height="300" loading="lazy"/></span><span class="aw-atlas-object"><img src={'/brand/sprites/'+room.sprite+'.webp'} alt="" width={room.w} height={room.h} loading="lazy"/><span class="aw-atlas-object-ring" aria-hidden="true"></span></span>
    <span class="aw-atlas-room-label"><small>{room.number} / {room.en}</small><strong>{room.ja}<span aria-hidden="true"> ↗</span></strong><span>{room.task}</span></span>
   </a>)}
  </nav>
  <div class="aw-atlas-legend"><span>EX LIBRIS · A.W. / {edition.english}</span><span>探索図 / 7つの入口</span></div>
 </div>
 <div class="aw-atlas-foot"><a href="/concepts/surplus-enjoyment/">コーラから余剰享楽を考える ↗</a><a href="/library/">すべての教材を検索 →</a></div>
</section>
