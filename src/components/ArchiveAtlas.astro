---
const rooms=[
 {id:'library',number:'02',en:'LIBRARY',ja:'資料の書庫',task:'教材・講演を探す',href:'/library/',sprite:'book-stack',w:435,h:265},
 {id:'observatory',number:'03',en:'OBSERVATORY',ja:'思想観測室',task:'テーマを横断する',href:'/topics/',sprite:'armillary',w:261,h:294},
 {id:'concepts',number:'05',en:'CATALOG OF IDEAS',ja:'概念の索引',task:'概念・作品を読む',href:'/concepts/',sprite:'marginalia-cards',w:413,h:216},
 {id:'lexicon',number:'04',en:'LEXICON LAB',ja:'言葉の標本室',task:'語彙・表現を探す',href:'/words/',sprite:'open-notebook',w:639,h:367},
 {id:'people',number:'06',en:'PERSONAL ARCHIVE',ja:'人物資料室',task:'話者・著者から読む',href:'/people/',sprite:'tied-cards',w:331,h:228},
 {id:'private',number:'08',en:'PRIVATE STUDY',ja:'自分の読書室',task:'個人教材を開く',href:'/workspace/',sprite:'desk-lamp',w:367,h:364}
