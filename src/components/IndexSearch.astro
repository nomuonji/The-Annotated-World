---
import ArchiveSearch from './ArchiveSearch.astro';
import EmptyState from './EmptyState.astro';
interface Props { label:string; count:number; unit:string; placeholder:string; prefix?:string }
const {label,count,unit,placeholder,prefix='index'}=Astro.props;
const inputId=prefix==='word'?'word-search':prefix+'-query';
---
<ArchiveSearch inputId={inputId} label={label} placeholder={placeholder} countId={prefix+"-count"} count={count} unit={unit} index/>
<EmptyState id={prefix+"-empty"} message="該当する項目がありません。別の言葉を試してください。"/>
<script>
const toolbar=document.querySelector<HTMLElement>('[data-index-controls]');
const input=toolbar?.querySelector<HTMLInputElement>('input');
const count=toolbar?.querySelector<HTMLElement>('[data-index-count]');
const empty=document.getElementById((count?.id||'index-count').replace(/-count$/,'-empty'));
if(toolbar&&input&&count&&empty){
 const items=[...document.querySelectorAll<HTMLElement>('[data-index-search]')];
 const sections=[...document.querySelectorAll<HTMLElement>('[data-index-section]')];
 const filter=()=>{const q=input.value.normalize('NFKC').toLowerCase().trim().split(/\s+/).filter(Boolean);let n=0;
  for(const item of items){item.hidden=!q.every(word=>item.dataset.indexSearch?.normalize('NFKC').toLowerCase().includes(word));if(!item.hidden)n++;}
  for(const section of sections)section.hidden=!section.querySelector('[data-index-search]:not([hidden])');
  count.textContent=n+(count.dataset.unit||'');empty.hidden=n!==0;
 };
 input.value=new URLSearchParams(location.search).get('q')||'';
 toolbar.hidden=false;input.addEventListener('input',filter);filter();
}
</script>
