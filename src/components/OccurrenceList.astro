---
import {occurrenceUrl,snippet,type Occurrence} from '../lib/lexicon';
interface Props{items:Occurrence[];needle:string;aliases?:string[]}
const {items,needle,aliases=[]}=Astro.props;
function parts(text:string){const term=[...aliases,needle].find(a=>a&&text.toLowerCase().includes(a.toLowerCase()));if(!term)return [{value:text,hit:false}];const i=text.toLowerCase().indexOf(term.toLowerCase());return [{value:text.slice(0,i),hit:false},{value:text.slice(i,i+term.length),hit:true},{value:text.slice(i+term.length),hit:false}];}
---
<div class="occurrences ed-evidence-ledger">{items.map(o=><article class="occurrence"><div class="occurrence-meta ed-citation"><a href={occurrenceUrl(o)}>{o.documentTitle}</a><span>{o.time}</span></div><h3><a href={occurrenceUrl(o)}>{o.chapterTitle} →</a></h3><p class="occurrence-en" lang="en">{parts(snippet(o.en,aliases.find(a=>o.en.toLowerCase().includes(a.toLowerCase()))||needle)).map(p=>p.hit?<mark>{p.value}</mark>:p.value)}</p>{o.termNote&&<p class="occurrence-note">{o.termNote}</p>}<details><summary>発話全体・対訳・注釈</summary><p class="occurrence-en" lang="en">{parts(o.en).map(p=>p.hit?<mark>{p.value}</mark>:p.value)}</p><p class="occurrence-ja">{o.ja}</p><p class="occurrence-note">{o.note}</p></details></article>)}</div>