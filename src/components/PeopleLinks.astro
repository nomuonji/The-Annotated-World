---
import {personUrl} from '../lib/discovery';
interface Props{items:{id:string;name:string;ja:string;count:number}[]}
const {items}=Astro.props;
---
<div class="people-grid">{items.map(p=><a class="person-item" href={personUrl(p.id)}><span class="person-monogram" aria-hidden="true">{p.name.split(' ').map(s=>s[0]).slice(0,2).join('')}</span><div><strong>{p.name}</strong><small>{p.ja} · {p.count}資料</small></div><span aria-hidden="true">↗</span></a>)}</div>