---
import type {CollectionEntry} from 'astro:content';
import {lessonUrl} from '../lib/lessons';
interface Props {lesson:CollectionEntry<'lessons'>}
const {data:l}=Astro.props.lesson;
---
<article class="lesson-card" data-entry data-category={l.category} data-search={[l.title,l.author,l.category,l.description,...l.tags].join(' ').toLowerCase()}>
<div class="cover" aria-hidden="true">{l.category.slice(0,2).toUpperCase()}</div>
<div><p class="tag">{l.category.toUpperCase()} · {l.rights.status==='original'?'ORIGINAL':'ANNOTATED READING'}</p><h3><a href={lessonUrl(l.id)}>{l.title}</a></h3><p>{l.author}</p><p>{l.description}</p><p>{l.chapters.length}章 {l.duration&&' · '+l.duration}</p></div><a class="action" href={lessonUrl(l.id)}>読む</a>
</article>