---
interface Props { href:string; title:string; detail?:string; meta:string; search?:string; english?:boolean; kind?:string; serial?:number; evidence?:string; evidenceSource?:string }
const {href,title,detail,meta,search,english=false,kind,serial,evidence,evidenceSource}=Astro.props;
const match=evidence?.toLowerCase().indexOf(title.toLowerCase())??-1;
---
<a class:list={["word-card","aw-index-record",english?"aw-word-specimen":"aw-concept-file"]} href={href} data-index-search={search} data-kind={kind}>{!evidence&&<span class="aw-index-tab" aria-hidden="true">{serial!==undefined?String(serial).padStart(3,"0"):"·"}{kind&&<span>{kind}</span>}</span>}<strong lang={english?'en':undefined}>{title}</strong>{detail&&<span class="ed-term-note">{detail}</span>}{evidence&&<span class="ed-evidence"><span lang="en">{match>=0?<>{evidence.slice(0,match)}<mark>{evidence.slice(match,match+title.length)}</mark>{evidence.slice(match+title.length)}</>:evidence}</span>{evidenceSource&&<small>{evidenceSource}</small>}</span>}<small>{meta}</small></a>
