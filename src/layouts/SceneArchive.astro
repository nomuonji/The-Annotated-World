---
const title='The Annotated World';
const description='世界には注釈を。英語・思想・文化の原文を対訳と注釈で読む資料室。';
const activePath=Astro.url.pathname;
const canonical=new URL(activePath,'https://the-annotated-world.pages.dev').href;
const buildSha=process.env.CF_PAGES_COMMIT_SHA||process.env.GITHUB_SHA||'';
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<script is:inline>
(()=>{
 let choice;
 try{choice=localStorage.getItem('aw-theme');}catch{}
 const dark=choice==='dark'||(choice!=='light'&&window.matchMedia('(prefers-color-scheme: dark)').matches);
 document.documentElement.dataset.theme=dark?'dark':'light';
 document.documentElement.classList.add('aw-js');
})();
</script>
<meta name="description" content={description}/>{buildSha&&<meta name="aw-build-sha" content={buildSha}/>}{activePath!=="/404.html"&&<link rel="canonical" href={canonical}/>}<meta property="og:url" content={canonical}/><link rel="icon" href="/brand/mark.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content="https://the-annotated-world.pages.dev/brand/midnight-desktop.webp"/><meta name="twitter:card" content="summary_large_image"/><link rel="alternate" type="application/json" title="Content catalog" href="/catalog.json"/><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Noto+Sans+JP:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="/scene-first-home.css"/>
</head>
<body><div class="world" id="top">
<a class="skip-link" href="#main">本文へ</a>
<slot name="masthead"/>
<main id="main" tabindex="-1"><slot/></main>
<div class="desk" aria-hidden="true"></div>
<footer class="foot">THE ANNOTATED WORLD · 世界には注釈を。自分には、まだ。</footer>
</div>
<script is:inline>
(()=>{
 const button=document.getElementById('site-theme-toggle');
 if(!button)return;
 const sync=()=>{
  const dark=document.documentElement.dataset.theme==='dark';
  button.setAttribute('aria-pressed',String(dark));
  button.textContent=dark?'ライト':'ダーク';
  button.title=dark?'サイト全体をライトモードにする':'サイト全体をダークモードにする';
 };
 button.addEventListener('click',()=>{
  const dark=document.documentElement.dataset.theme!=='dark';
  document.documentElement.dataset.theme=dark?'dark':'light';
  try{localStorage.setItem('aw-theme',dark?'dark':'light');}catch{}
  sync();
 });
 window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',event=>{
  try{if(localStorage.getItem('aw-theme')!==null)return;}catch{return;}
  document.documentElement.dataset.theme=event.matches?'dark':'light';
  sync();
 });
 sync();
})();
</script>
</body></html>
