{
  "name": "the-annotated-world",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify:archive": "node scripts/verify-archive.mjs",
    "verify:reader": "node scripts/verify-reader.mjs",
    "content:inspect": "node scripts/content-inspect.mjs",
    "content:check": "node scripts/content-inspect.mjs --check",
    "short:init": "node scripts/annotated-short.mjs init",
    "short:check": "node scripts/annotated-short.mjs validate",
    "short:plan": "node scripts/annotated-short.mjs plan",
    "short:render": "python3 tools/annotated-short/render.py",
    "short:discover": "node scripts/short-studio.mjs discover",
    "short:studio:check": "node scripts/short-studio.mjs check",
    "short:studio:plan": "node scripts/short-studio.mjs plan",
    "short:studio:render": "python3 tools/annotated-short/studio.py",
    "short:metrics": "node scripts/short-studio.mjs metrics",
    "short:studio:verify": "python3 tools/annotated-short/verify-studio.py",
    "short:script:prepare": "node scripts/clip-script.mjs prepare",
    "short:script:export": "node scripts/clip-script.mjs export",
    "short:script:verify": "node --test scripts/verify-clip-script.mjs",
    "short:productions": "node scripts/production-status.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^6.0.0",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "playwright": "^1.56.0"
  }
